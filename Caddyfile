amstartransmissions.org, www.amstartransmissions.org, app.amstartransmissions.org {
  encode gzip

    handle /api/auth/forgot-password {
      rate_limit {
        zone reset_email {
          key {remote_host}
          events 3
          window 1h
        }
      }
      reverse_proxy backend:8080
    }

    handle /api/auth/* {
      rate_limit {
        zone auth {
          key {remote_host}
          events 10
          window 1m
        }
      } 
      reverse_proxy backend:8080
    }

    handle /api/* {
      reverse_proxy backend:8080
    }

    handle {
      root * /srv
      try_files {path} /index.html
      file_server
    }

    header {
      Strict-Transport-Security "max-age=31536000; includeSubDomains"
      X-Content-Type-Options "nosniff"
      Referrer-Policy "strict-origin-when-cross-origin"
      X-Frame-Options "DENY"
    }
}
