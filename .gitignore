# === OS ===
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
desktop.ini

# === Editors / IDEs ===
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

# === Secrets / local env ===
# Datasource config comes from the environment (see docker-compose.yml),
# so any local env files must stay out of the repo.
.env
.env.*
!.env.example
!frontend/.env.production
*.local
docker-compose.override.yml

# === Browser automation scratch ===
# Playwright MCP writes console logs, page snapshots, and any downloads here.
# Never commit it — downloads that land in this directory can be arbitrary.
.playwright-mcp/

# === Claude Code / agent tooling ===
# CLAUDE.md is intentionally tracked — it is the project's shared guidance file.
# Everything else Claude writes is per-machine or per-session.
.claude/
CLAUDE.local.md
.superpowers/
.aider*
.cursor/
.windsurfrules

# === Build output (backend/ and frontend/ also carry their own .gitignore) ===
target/
node_modules/
dist/
dist-ssr/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
